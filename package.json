{
  "name": "deutsch-a1",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm start -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm start -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@angular/forms": "^22.1.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "sharp@0.35.4": true,
    "sharp@0.32.6": true
  }
}
